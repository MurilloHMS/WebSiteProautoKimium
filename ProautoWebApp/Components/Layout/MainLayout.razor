@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudLayout>
    <MudAppBar Elevation="1" Dense="true" Style="background-color: white">
        <MudGrid Justify="Justify.Center">
            <MudSpacer/>
            <MudItem xs="3">
                <MudPaper Elevation="0">
                    <MudImage Fluid="true" Src="images/logo-proauto.png" Alt="Logo Proauto Kimium" Class="rounded-lg" Width="200"></MudImage>
                </MudPaper>
            </MudItem>
            <MudItem >
                <MudPaper Elevation="0">
                    <MudNavLink Href="/" Match="NavLinkMatch.All">Home</MudNavLink>
                </MudPaper>
            </MudItem>
            <MudItem >
                <MudPaper Elevation="0">
                    <MudNavLink>Empresa</MudNavLink>
                </MudPaper>
            </MudItem>
            <MudItem >
                <MudPaper Elevation="0">
                    <MudNavLink>Produtos</MudNavLink>
                </MudPaper>
            </MudItem>
            <MudItem >
                <MudPaper Elevation="0">
                    <MudNavLink>Clientes</MudNavLink>
                </MudPaper>
            </MudItem>
            <MudItem >
                <MudPaper Elevation="0">
                    <MudNavLink>Contato</MudNavLink>
                </MudPaper>
            </MudItem>
            <MudSpacer/>
            <MudItem >
                <MudPaper Elevation="0">
                    <MudIconButton Icon="@Icons.Material.Filled.ShoppingCart" Size="Size.Small"></MudIconButton>
                    |
                    <MudIconButton Icon="@Icons.Material.Filled.Person" Size="Size.Small"></MudIconButton>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudAppBar>
    @* <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2"> *@
    @*     $1$ <NavMenu /> #1# *@
    @* </MudDrawer> *@
    <MudMainContent Class="mt-16 pa-4">
        @Body
    </MudMainContent>
    <MudAppBar Bottom="true" Fixed="true" Style="background-color: white" Elevation="1" Dense="true">
        <MudGrid Justify="Justify.Center">
            <MudItem>
                <MudChip T="string" Icon="@Icons.Material.Filled.Email" Href="mailto:sac@proautokimium.com.br" Target="_blank" Size="Size.Small" Style="background-color: white">sac@proautokimium.com.br</MudChip>
            </MudItem>
            <MudItem>
                <MudChip T="string" Icon="@Icons.Material.Filled.Phone" Href="tel:+551145770399" Target="_blank" Size="Size.Small" Style="background-color: white">11 4577-0399</MudChip>
            </MudItem>
            <MudItem>
                <MudChip T="string" Icon="@Icons.Custom.Brands.WhatsApp" Href="https://wa.me/5511983583564" Target="_blank" Size="Size.Small" Style="background-color: white">11 9 8358-3564</MudChip>
            </MudItem>
            <MudItem>
                <MudChip T="string" Icon="@Icons.Custom.Brands.WhatsApp" Href="https://wa.me/5511957782766" Target="_blank" Size="Size.Small" Style="background-color: white">11 9 5778-2766</MudChip>
            </MudItem>
            <MudItem>
                <MudPaper Elevation="0">
                    <MudChip T="string" Icon="@Icons.Custom.Brands.LinkedIn" Href="https://www.linkedin.com/company/proauto-kimium/" Target="_blank" Size="Size.Small" Style="background-color: white"/>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudAppBar>
</MudLayout>


<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private bool _drawerOpen = true;

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

}


