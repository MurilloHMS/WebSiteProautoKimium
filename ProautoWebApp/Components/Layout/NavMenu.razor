        <MudPaper Elevation="0">
            <MudNavLink>Contato</MudNavLink>
        </MudPaper>
    </MudItem>
    <MudSpacer/>
    <MudItem >
        <MudPaper Elevation="0">
            <MudIconButton Icon="@Icons.Material.Filled.ShoppingCart" Size="Size.Small"></MudIconButton>
            |
            <MudMenu AnchorOrigin="Origin.CenterLeft" TransformOrigin="Origin.TopCenter">
                <ActivatorContent>
                    <MudIconButton Icon="@Icons.Material.Filled.Person" Size="Size.Small"></MudIconButton>
                </ActivatorContent>
                <ChildContent>
                    
                    <AuthorizeView>
                        <NotAuthorized>
                            <MudMenuItem Href="/account/login">Login</MudMenuItem>
                        </NotAuthorized>
                        <Authorized>
                            <MudMenuItem Href="/account/profile">Perfil</MudMenuItem>
                            <MudMenuItem Href="/account/logout">Sair</MudMenuItem>
                        </Authorized>
                    </AuthorizeView>


                </ChildContent>
            </MudMenu>
        </MudPaper>
    </MudItem>
</MudGrid>


@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}


