<MudMenu></MudMenu>

<MudGrid Justify="Justify.Center">
    <MudSpacer/>
    <MudItem xs="3">
        <MudPaper Elevation="0">
            <MudImage Fluid="true" Src="images/logo-proauto.png" Alt="Logo Proauto Kimium" Class="rounded-lg" Width="200"></MudImage>
        </MudPaper>
    </MudItem>
    <MudItem >
        <MudPaper Elevation="0">
            <MudNavLink Href="/" Match="NavLinkMatch.All">Home</MudNavLink>
        </MudPaper>
    </MudItem>
    <MudItem >
        <MudPaper Elevation="0">
            <MudNavLink>Empresa</MudNavLink>
        </MudPaper>
    </MudItem>
    <MudItem >
        <MudPaper Elevation="0">
            <MudNavLink Href="/produtos" Match="NavLinkMatch.All">Produtos</MudNavLink>
