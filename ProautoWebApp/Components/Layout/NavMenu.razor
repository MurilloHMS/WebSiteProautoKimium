@implements IDisposable

@inject NavigationManager NavigationManager

<MudNavMenu >
     <AuthorizeView>
         <Authorized>
             <form action="Account/Logout" method="post" hidden="true">
                 <AntiforgeryToken />
                 <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                 <button type="submit" class="mud-nav-link mud-ripple">
                     <MudIcon Icon="@Icons.Material.Filled.Logout" Color="Color.Info" Class="mr-3"></MudIcon> Logout
                 </button>
             </form>
         </Authorized>
     </AuthorizeView>
</MudNavMenu>

<MudGrid Justify="Justify.Center">
    <MudSpacer/>
    <MudItem xs="3">
        <MudPaper Elevation="0">
            <MudImage Fluid="true" Src="images/logo-proauto.png" Alt="Logo Proauto Kimium" Class="rounded-lg" Width="200"></MudImage>
        </MudPaper>
    </MudItem>
    <MudItem >
        <MudPaper Elevation="0">
            <MudNavLink Href="/" Match="NavLinkMatch.All">Home</MudNavLink>
        </MudPaper>
    </MudItem>
    <MudItem >
        <MudPaper Elevation="0">
            <MudNavLink>Empresa</MudNavLink>
        </MudPaper>
    </MudItem>
    <MudItem >
        <MudPaper Elevation="0">
            <MudNavLink Href="/produtos" Match="NavLinkMatch.All">Produtos</MudNavLink>
        </MudPaper>
    </MudItem>
    <AuthorizeView>
        <Authorized>
            <MudItem>
                <MudPaper Elevation="0">
                    <MudNavLink Href="/produtos/cadastro">Cadastro</MudNavLink>
                </MudPaper>
            </MudItem>
        </Authorized>
    </AuthorizeView>
    <MudItem >
        <MudPaper Elevation="0">
            <MudNavLink>Contato</MudNavLink>
        </MudPaper>
    </MudItem>
    <MudSpacer/>
    <MudItem >
        <MudPaper Elevation="0">
            <MudIconButton Icon="@Icons.Material.Filled.ShoppingCart" Size="Size.Small"></MudIconButton>
            |
            <MudMenu AnchorOrigin="Origin.CenterLeft" TransformOrigin="Origin.TopCenter">
                <ActivatorContent>
                    <MudIconButton Icon="@Icons.Material.Filled.Person" Size="Size.Small"></MudIconButton>
                </ActivatorContent>
                <ChildContent>
                    <AuthorizeView>
                        <NotAuthorized>
                            <MudMenuItem Href="/account/login">Login</MudMenuItem>
                        </NotAuthorized>
                        <Authorized>
                            <MudMenuItem Href="/account/manage">Perfil</MudMenuItem>
                            <form action="Account/Logout" method="post">
                                <AntiforgeryToken />
                                <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                                <button type="submit" class="mud-nav-link mud-ripple">
                                    <MudIcon Icon="@Icons.Material.Filled.Logout" Color="Color.Info" Class="mr-3"></MudIcon> Logout
                                </button>
                            </form>
                        </Authorized>
                    </AuthorizeView>
                </ChildContent>
            </MudMenu>
        </MudPaper>
    </MudItem>
</MudGrid>


@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}


